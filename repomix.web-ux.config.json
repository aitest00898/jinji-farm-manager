{
  "input": {
    "maxFileSize": 1500000
  },
  "output": {
    "filePath": "audit-output/web-ux-audit.xml",
    "style": "xml",
    "filePathStyle": "target-relative",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "showLineNumbers": true,
    "truncateBase64": true,
    "topFilesLength": 15
  },
  "include": [
    "README.md",
    ".gitignore",
    "package.json",
    "index.html",
    "tsconfig.json",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/App.tsx",
    "src/api.ts",
    "src/local-audit.ts",
    "src/navigation.ts",
    "src/styles.css",
    "src/main.tsx",
    "public/**",
    "tests/mobile.spec.ts",
    "tests/local-audit.spec.ts",
    "docs/external-local-audit.md",
    "repomix.web-ux.config.json"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": false,
    "customPatterns": [
      ".git/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/coverage/**",
      "**/test-results/**",
      "**/playwright-report/**",
      "**/.wrangler/**",
      "**/.cache/**",
      "**/.vite/**",
      "**/.env*",
      "**/.dev.secrets.local*",
      "**/.dev.vars*",
      "audit-output/**",
      "repomix-output.*"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
