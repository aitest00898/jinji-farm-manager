{
  "name": "chicken-line-production",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:import:local": "wrangler d1 execute DB --local --file=scripts/import_mafu.sql",
    "db:import:remote": "wrangler d1 execute DB --remote --file=scripts/import_mafu.sql",
    "db:aliases:local": "wrangler d1 execute DB --local --file=scripts/seed_operational_aliases.sql",
    "db:aliases:remote": "wrangler d1 execute DB --remote --file=scripts/seed_operational_aliases.sql",
    "db:fixture:local": "wrangler d1 execute DB --local --file=scripts/operational_fixture.sql",
    "db:phase2:fixture": "wrangler d1 execute DB --local --file=scripts/phase2_fixture.sql",
    "runtime:validate": "node scripts/runtime-validation.mjs",
    "runtime:menu-local": "node scripts/menu-runtime-local.mjs",
    "runtime:quick-record-local": "node scripts/quick-record-runtime-local.mjs",
    "runtime:ambient-local": "node scripts/quiet-ambient-runtime-local.mjs",
    "runtime:manual-ambient-local": "node scripts/manual-ambient-runtime-local.mjs",
    "runtime:scheduled-ambient-local": "node scripts/scheduled-ambient-runtime-local.mjs",
    "runtime:dev-ambient-local": "node scripts/development-ambient-runtime-local.mjs",
    "runtime:digest-v2-local": "node scripts/digest-v2-runtime-local.mjs",
    "runtime:candidate-repair-local": "node scripts/candidate-repair-runtime-local.mjs",
    "runtime:conversational-preview-local": "node scripts/conversational-preview-runtime-local.mjs",
    "runtime:conversation-v2-local": "node scripts/conversation-v2-runtime-local.mjs",
    "runtime:conversation-v2-e2e-local": "node scripts/conversation-v2-runtime-local.mjs",
    "runtime:fast-path-local": "node scripts/fast-path-runtime-local.mjs",
    "runtime:reliability-faults": "vitest run src/reliability.test.ts",
    "runtime:daily-review-local": "node scripts/daily-review-runtime-local.mjs",
    "conversation-v2-eval": "node scripts/conversation-v2-eval.mjs",
    "bench:semantic": "node scripts/semantic-benchmark.mjs",
    "ambient:extraction-v2": "vitest run src/ambient-extraction-v2.test.ts",
    "ambient:extraction-v2-real-smoke": "node scripts/ambient-extraction-v2-real-smoke.mjs",
    "ambient:extraction-v2-d03-diagnostic": "node scripts/ambient-extraction-v2-real-smoke.mjs --d03-only",
    "ambient:semantic-eval": "node scripts/ambient-semantic-eval.mjs",
    "ambient:semantic-schema-micro": "node scripts/ambient-semantic-eval-schema-micro.mjs",
    "ambient:semantic-kind-fix": "node scripts/ambient-semantic-eval-schema-micro.mjs --d05-only"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  }
}
