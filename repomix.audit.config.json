{
  "$schema": "https://repomix.com/schemas/repomix-schema.json",
  "input": {
    "maxFileSize": 1500000
  },
  "output": {
    "filePath": ".audit-output/full-engineering-audit.xml",
    "style": "xml",
    "filePathStyle": "target-relative",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "showLineNumbers": true,
    "truncateBase64": true,
    "topFilesLength": 15
  },
  "include": [
    "AGENTS.md",
    "README.md",
    ".gitignore",
    ".github/**",
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/**",
    "tests/**",
    "public/**",
    "backend/package.json",
    "backend/package-lock.json",
    "backend/tsconfig.json",
    "backend/vitest.config.ts",
    "backend/src/**",
    "backend/migrations/**",
    "backend/scripts/**/*.mjs",
    "docs/AMBIENT_AI_EXTRACTION_CONTRACT.md",
    "docs/AMBIENT_DEV_DEBUG_WORKFLOW.md",
    "docs/CONVERSATION_EVIDENCE_MODEL.md",
    "docs/CONVERSATION_ORCHESTRATOR_V2.md",
    "docs/CONVERSATION_V2_GROUP_ROLLOUT.md",
    "docs/LINE_ACTION_AUDIT.md",
    "docs/LINE_FAST_PATH_AUDIT.md",
    "docs/LINE_INTERACTION_STANDARD.md",
    "docs/LINE_MENU_ACCESS_MATRIX.md",
    "docs/target-architecture.md",
    "docs/target-architecture-memory-card.md",
    "docs/external-local-audit.md",
    "scripts/audit-security-scan.mjs",
    "repomix.audit.config.json",
    "repomix.web-ux.config.json"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".git/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/coverage/**",
      "**/test-results/**",
      "**/playwright-report/**",
      "**/.wrangler/**",
      "**/.cache/**",
      "**/.vite/**",
      "**/.env*",
      "**/.dev.secrets.local*",
      "**/.dev.vars*",
      "backend/wrangler*.jsonc",
      "backend/config/**",
      "backend/benchmarks/**",
      "backend/forensics/**",
      "backend/scripts/*.sql",
      "backend/DEPLOYMENT_REPORT.md",
      "backend/FINAL_CLOSEOUT_REPORT.md",
      "backend/SYSTEM_CONFORMANCE_REPORT.md",
      "backend/HUMAN_STEPS.md",
      "docs/current-execution-state.md",
      "docs/CONVERSATION_PRODUCTION_TRACE.md",
      "docs/PRODUCTION_CONVERSATION_TRACE_REPORT.md",
      "docs/developer-auth.md",
      "docs/LINE_RELIABILITY.md",
      ".audit-output/**",
      "repomix-output.*"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
