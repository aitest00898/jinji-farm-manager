{
  "input": {
    "maxFileSize": 1500000
  },
  "output": {
    "filePath": "audit-output/full-engineering-audit.xml",
    "style": "xml",
    "filePathStyle": "target-relative",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "showLineNumbers": true,
    "truncateBase64": true,
    "topFilesLength": 15
  },
  "include": [
    "AGENTS.md",
    "README.md",
    ".gitignore",
    "package.json",
    "package-lock.json",
    "index.html",
    "tsconfig.json",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/**",
    "tests/**",
    "public/**",
    "docs/external-local-audit.md",
    "docs/operation-inventory.md",
    "docs/production-contract-parity.md",
    "docs/source-parity.md",
    "scripts/audit-security-scan.mjs",
    "repomix.audit.config.json",
    "repomix.web-ux.config.json",
    "repomix.ui-pack.config.json",
    "repomix.adapter-pack.config.json",
    "repomix.tests-pack.config.json"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": false,
    "customPatterns": [
      ".git/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/coverage/**",
      "**/test-results/**",
      "**/playwright-report/**",
      "**/.wrangler/**",
      "**/.cache/**",
      "**/.vite/**",
      "**/.env*",
      "**/.dev.secrets.local*",
      "**/.dev.vars*",
      "audit-output/**",
      "repomix-output.*"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
